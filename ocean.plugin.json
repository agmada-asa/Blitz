{
  "id": "blitz",
  "name": "Blitz",
  "server": {
    "command": ["node", "mcp/server.mjs"],
    "env": { "BLITZ_OCEAN": "1" }
  },
  "needsApp": "Blitz",
  "tools": {
    "today": "read",
    "list_modules": "read",
    "read_module": "read",
    "create_module": "write",
    "add_material": "write",
    "app_home": { "risk": "read", "actor": "human" },
    "app_module": { "risk": "read", "actor": "human" },
    "app_review": { "risk": "read", "actor": "human" },
    "app_answer": { "risk": "write", "actor": "human" },
    "app_reveal": { "risk": "read", "actor": "human" },
    "app_recall": { "risk": "write", "actor": "human" },
    "app_skip": { "risk": "write", "actor": "human" }
  },
  "widgets": [
    {
      "id": "today",
      "name": "Blitz",
      "note": "Today's XP, your streak and what to study next. Tap one to open it.",
      "resource": "ocean://widgets/today",
      "wide": true,
      "refresh": 900
    }
  ],
  "app": {
    "dir": "ocean-app/dist",
    "src": "ocean-app/src",
    "build": ["node", "ocean-app/build.mjs"],
    "icon": "ocean-app/icon.svg"
  }
}
