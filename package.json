{
  "name": "blitz",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev-lan.mjs",
    "desktop": "electron electron/main.mjs",
    "worker": "node --experimental-strip-types scripts/preparation-worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "worker:chat": "node --experimental-strip-types scripts/chat-worker.ts",
    "worker:research": "node --experimental-strip-types scripts/research-worker.ts",
    "worker:ingestion": "node --experimental-strip-types scripts/ingestion-worker.ts",
    "worker:content": "node --experimental-strip-types scripts/content-generation-worker.ts",
    "eval:ingestion": "node --experimental-strip-types scripts/eval-ingestion.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/bbh-bartle": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "entities": "^8.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
